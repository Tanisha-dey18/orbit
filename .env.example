# ---------------------------------------------------------------------------
# PROJECT ORBIT configuration. Copy to `.env` (repo root) and adjust.
# Never commit your real .env. All values below are safe local defaults.
# ---------------------------------------------------------------------------

# --- Backend (read by FastAPI; relative paths are resolved from the repo root) ---
ORBIT_DATABASE_URL=sqlite:///artifacts/orbit.db
ORBIT_ARTIFACT_DIR=artifacts
ORBIT_MODEL_PATH=data/checkpoints/orbit_fc_siam_diff.pt
ORBIT_MAX_UPLOAD_MB=25
# Comma-separated list of frontend origins allowed to call the API (no "*" in production)
ORBIT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# auto | cpu | cuda
ORBIT_DEVICE=auto
ORBIT_MAX_PROCESSING_SIDE=2048
ORBIT_MAX_BATCH_PAIRS=5
ORBIT_MAX_CONCURRENT_ANALYSES=2
ORBIT_LOG_LEVEL=INFO
ORBIT_LOG_JSON=false

# --- Frontend (put this one in frontend/.env.local or your hosting provider's settings) ---
# Empty = use the Vite dev proxy (/api -> http://127.0.0.1:8000).
VITE_API_BASE_URL=
